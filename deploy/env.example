# Credentials for the panel. Referenced from config.yaml as ${VAR}.
# chmod 600 this file. Nothing here should ever land in git.

PVE_TOKEN_SECRET=
UNIFI_API_KEY=
WAZUH_PASSWORD=
WAZUH_INDEXER_PASSWORD=
PIHOLE_PASSWORD=
B2_KEY_ID=
B2_APP_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
SPLUNK_PASSWORD=
AUTHENTIK_TOKEN=
JELLYFIN_API_KEY=
HEARTBEAT_URL=

# Optional: only for the `updates` collector, and only to raise GitHub's
# unauthenticated rate limit. A public-repo read needs no scopes.
GITHUB_TOKEN=

# Log level (debug | info | warning | error). Case does not matter.
PANEL_LOG_LEVEL=info
